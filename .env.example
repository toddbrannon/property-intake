# Copy this file to a new file named exactly  .env  and fill in the values.
# Lines starting with # are comments.

# 1. Your Anthropic API key. Starts with sk-ant-. Keep this file private.
#    Leave it blank to run without the API: the sample PDFs work as they are, and any other
#    PDF works if you run the prompt in the Claude app and save the reply beside it (SOP Step 3b).
ANTHROPIC_API_KEY=

# 2. Which Claude model to use. Leave as is unless told otherwise.
CLAUDE_MODEL=claude-sonnet-5-5

# 3. Folders. Use full paths. On Windows write them like  C:/Users/hinode/Nutstore/PropertyIntake/inbox
INBOX_DIR=./inbox
DONE_DIR=./done
FAILED_DIR=./failed
OUTPUT_DIR=./output

# 4. How often watch.py checks the inbox, in seconds.
POLL_SECONDS=60
